<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetPdfGen\DotnetPdfGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample templates are read from the content root at runtime. -->
    <Content Remove="Templates\**" />
    <Content Include="Templates\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
